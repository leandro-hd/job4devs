# Database
DATABASE_URL=postgresql://user:password@localhost:5432/job4devs

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM="job4devs <alerts@job4devs.dev>"
EMAIL_TRANSACTIONAL_FROM="job4devs <noreply@job4devs.dev>"

# Worker
DEFAULT_CRON_INTERVAL_MINUTES=5

# 99freelas auth (optional — needed to fetch avg proposal value from bid pages)
# Extract from browser DevTools → Application → Cookies → www.99freelas.com.br
# kmlicin = user ID, kmlicn = remember-me token (valid ~1 year)
FREELAS99_AUTH_ID=
FREELAS99_AUTH_TOKEN=

# URLs
# In production these point to the deployed frontend/backend (CORS uses FRONTEND_URL).
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# Server
PORT=3000
